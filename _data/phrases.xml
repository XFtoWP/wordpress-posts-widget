  <phrase title="widget_def.kolakube_wp_posts" version_id="1000070" version_string="1.0.0"><![CDATA[WordPress Posts]]></phrase>
  <phrase title="widget_def_desc.kolakube_wp_posts" version_id="1000070" version_string="1.0.0"><![CDATA[Displays chosen WordPress posts or WooCommerce products.]]></phrase>
